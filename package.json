{
  "name": "conveyor",
  "license": "AGPL-3.0-or-later",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "plugins/*/*"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:api": "bun run --cwd packages/api dev",
    "dev:worker": "bun run --cwd packages/worker dev",
    "dev": "docker compose up --build",
    "lint": "biome check --formatter-enabled=false --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "check:comments": "bun scripts/checks/comments.ts --strict",
    "check:lines": "bun scripts/checks/lines.ts",
    "check:colours": "bun scripts/checks/colours.ts",
    "check:casts": "bun scripts/checks/casts.ts",
    "check:test-leaks": "bun scripts/checks/test-leaks.ts",
    "slicer-keys": "bun scripts/slicer-keys/generate.ts",
    "check:slicer-keys": "bun scripts/slicer-keys/generate.ts --check",
    "check:bundle": "bun scripts/checks/bundle.ts",
    "check:bundle:update": "bun scripts/checks/bundle.ts --update",
    "check:coverage": "bun scripts/checks/coverage/main.ts",
    "check:coverage:update": "bun scripts/checks/coverage/main.ts --update"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "~1.3.14",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  }
}
