{
  "name": "conveyor",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "plugins/*/*"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:api": "bun run --cwd packages/api dev",
    "dev:worker": "bun run --cwd packages/worker dev",
    "dev": "docker compose up --build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check:comments": "bun scripts/checks/comments.ts",
    "check:comments:update": "bun scripts/checks/comments.ts --update"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "ioredis": "5.10.1"
  }
}
