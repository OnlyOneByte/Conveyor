{
	skip_install_trust
}

localhost {
	encode gzip zstd

	header {
		defer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}
	@public_host not host localhost
	header @public_host Strict-Transport-Security "max-age=31536000"

	handle /health {
		reverse_proxy api:3000
	}
	handle /jobs* {
		reverse_proxy api:3000
	}
	handle /generators* {
		reverse_proxy api:3000
	}
	handle /uploads* {
		reverse_proxy api:3000
	}
	handle /auth* {
		reverse_proxy api:3000
	}
	handle /jobs-history* {
		reverse_proxy api:3000
	}
	handle /catalog* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:3000
	}
}
